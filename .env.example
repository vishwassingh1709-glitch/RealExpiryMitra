# ExpiryMitra Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database Persistence: Google Cloud Firestore
# ------------------------------------------------------------------------------
# Leave blank to use local JSON storage adapter for offline testing/development.
# When ready for Firestore, configure these 3 variables from your Firebase Service Account JSON.
STORAGE_PROVIDER=auto
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, copy the private key string from your service account JSON.
# Note: Escape newlines as \n if putting inside quotes: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. AI Interpretation: Google Gemini API (Free Tier eligible)
# ------------------------------------------------------------------------------
# Get your free-tier Gemini API key from Google AI Studio: https://aistudio.google.com/
# If left blank, ExpiryMitra automatically uses the robust deterministic rule parser fallback.
GEMINI_API_KEY=const API_KEY = GOOGLE_API_KEY=your_google_api_key_here;
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. OCR Engine Configuration
# ------------------------------------------------------------------------------
# OCR_PROVIDER options:
# - "tesseract" : Free, open-source offline OCR engine (works out-of-the-box, no API key required)
# - "ocr_space" : Cloud OCR API (requires OCR_API_KEY from https://ocr.space/ocrapi)
# - "mock"      : Deterministic mock for unit test environments
OCR_PROVIDER=tesseract
OCR_API_KEY=K86505070288957
OCR_LANGUAGE=eng
OCR_ENGINE=2

# ------------------------------------------------------------------------------
# 4. External Services & Timeouts
# ------------------------------------------------------------------------------
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2/product
EXTERNAL_API_TIMEOUT_MS=15000
